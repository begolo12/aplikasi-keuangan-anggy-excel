# Database Connection String (Neon PostgreSQL) - SERVER-SIDE ONLY
DATABASE_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require"

# JWT Secret for Session Authentication (minimal 32 karakter) - generate: openssl rand -base64 32  atau  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET="change-me-generate-with-openssl-rand-base64-32"
